import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Gerenciador de Território',
      theme: ThemeData(
        primarySwatch: Colors.indigo,
        scaffoldBackgroundColor: const Color(0xFFF4F5F8),
      ),
      home: const HomeScreen(),
    );
  }
}

class HomeScreen extends StatelessWidget {
  const HomeScreen({super.key});

  final List<Map<String, dynamic>> _menuItems = const [
    {'title': 'Territórios', 'icon': Icons.map, 'screen': TerritoriosScreen()},
    {'title': 'Serviço de Campo', 'icon': Icons.book, 'screen': CampoScreen()},
    {'title': 'Eventos', 'icon': Icons.event, 'screen': EventosScreen()},
    {'title': 'Dirigente', 'icon': Icons.group, 'screen': DirigenteScreen()},
    {'title': 'S-13', 'icon': Icons.assignment, 'screen': S13Screen()},
    {'title': 'Administrador', 'icon': Icons.admin_panel_settings, 'screen': AdminScreen()},
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'MAPA DO TERRITÓRIO',
          style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 18),
        ),
        backgroundColor: const Color(0xFF1A365D),
        centerTitle: true,
        elevation: 0,
      ),
      body: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Território de Congregação',
              style: TextStyle(
                fontSize: 18,
                fontWeight: FontWeight.bold,
                color: Color(0xFF1A365D),
              ),
            ),
            const SizedBox(height: 16),
            Expanded(
              child: GridView.builder(
                gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                  crossAxisCount: 3,
                  crossAxisSpacing: 12,
                  mainAxisSpacing: 12,
                  childAspectRatio: 0.85,
                ),
                itemCount: _menuItems.length,
                itemBuilder: (context, index) {
                  final item = _menuItems[index];
                  return InkWell(
                    onTap: () {
                      Navigator.push(
                        context,
                        MaterialPageRoute(builder: (context) => item['screen']),
                      );
                    },
                    child: Container(
                      decoration: BoxDecoration(
                        color: Colors.white,
                        borderRadius: BorderRadius.circular(12),
                        boxShadow: [
                          BoxShadow(
                            color: Colors.black.withOpacity(0.05),
                            blurRadius: 5,
                            offset: const Offset(0, 2),
                          ),
                        ],
                      ),
                      child: Column(
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: [
                          Icon(
                            item['icon'],
                            size: 32,
                            color: const Color(0xFF4A5568),
                          ),
                          const SizedBox(height: 12),
                          Text(
                            item['title'],
                            textAlign: TextAlign.center,
                            style: const TextStyle(
                              fontSize: 13,
                              fontWeight: FontWeight.bold,
                              color: Colors.black87,
                            ),
                          ),
                        ],
                      ),
                    ),
                  );
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}

// --- TELA DE TERRITÓRIOS ---

class TerritoriosScreen extends StatelessWidget {
  const TerritoriosScreen({super.key});

  final List<String> _territorios = const [
    'T-1 ST TEREZINHA',
    'T-2 ST TEREZINHA 2',
    'T-3 FANTINATO 1',
    'T-4 FANTINATO 2',
    'T-5 FANTINATO 3',
    'T-6 JD VITÓRIA',
    'T-7 CHAPARRAL 1',
    'T-8 CHAPARRAL 2',
    'T-9 JD PANSANE',
    'T-10 JD ELDORADO 1',
    'T-11 CHAPARRAL 3',
    'T-12 ARAUCÁRIA 1',
    'T-13 ARAUCÁRIA 2',
    'T-14 JD ELDORADO 2',
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        iconTheme: const IconThemeData(color: Colors.white, size: 28),
        title: const Text(
          'Território da Congregação',
          style: TextStyle(
            color: Colors.white,
            fontWeight: FontWeight.bold,
            fontSize: 21,
          ),
        ),
        backgroundColor: const Color(0xFF1A365D),
      ),
      body: ListView.builder(
        padding: const EdgeInsets.all(12),
        itemCount: _territorios.length,
        itemBuilder: (context, index) {
          return Card(
            elevation: 2,
            margin: const EdgeInsets.symmetric(vertical: 6, horizontal: 4),
            shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
            child: ListTile(
              leading: CircleAvatar(
                backgroundColor: const Color(0xFF1A365D),
                child: Text(
                  '${index + 1}',
                  style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold),
                ),
              ),
              title: Text(
                _territorios[index],
                style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 16),
              ),
              subtitle: const Text('Status: Disponível • Toque para ver detalhes'),
              trailing: const Icon(Icons.arrow_forward_ios, size: 16),
              onTap: () {
                Navigator.push(
                  context,
                  MaterialPageRoute(
                    builder: (context) => TerritorioDetalheScreen(nomeTerritorio: _territorios[index]),
                  ),
                );
              },
            ),
          );
        },
      ),
    );
  }
}

// --- TELA DE DETALHES ---

class TerritorioDetalheScreen extends StatefulWidget {
  final String nomeTerritorio;
  const TerritorioDetalheScreen({super.key, required this.nomeTerritorio});

  @override
  State<TerritorioDetalheScreen> createState() => _TerritorioDetalheScreenState();
}

class _TerritorioDetalheScreenState extends State<TerritorioDetalheScreen> {
  bool _temMapaCarregado = false;

  void _simularSelecaoGaleria() {
    setState(() {
      _temMapaCarregado = !_temMapaCarregado;
    });
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(_temMapaCarregado 
          ? 'Mapa carregado da galeria com sucesso!' 
          : 'Mapa removido.'),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        iconTheme: const IconThemeData(color: Colors.white, size: 28),
        title: Text(
          widget.nomeTerritorio,
          style: const TextStyle(color: Colors.white, fontSize: 20, fontWeight: FontWeight.bold),
        ),
        backgroundColor: const Color(0xFF1A365D),
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              widget.nomeTerritorio,
              style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold, color: Color(0xFF1A365D)),
            ),
            const SizedBox(height: 14),
            const Text(
              'Mapa do Território:',
              style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: Colors.black87),
            ),
            const SizedBox(height: 8),
            
            // Container do Mapa
            Container(
              height: 240,
              width: double.infinity,
              decoration: BoxDecoration(
                color: Colors.grey[200],
                borderRadius: BorderRadius.circular(12),
                border: Border.all(color: Colors.grey.shade400),
              ),
              child: _temMapaCarregado
                  ? Center(
                      child: Column(
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: const [
                          Icon(Icons.map, size: 70, color: Color(0xFF1A365D)),
                          SizedBox(height: 10),
                          Text(
                            'Visualizando Mapa da Galeria',
                            style: TextStyle(fontWeight: FontWeight.bold, fontSize: 16, color: Color(0xFF1A365D)),
                          ),
                        ],
                      ),
                    )
                  : Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: const [
                        Icon(Icons.photo_library_outlined, size: 50, color: Colors.grey),
                        SizedBox(height: 8),
                        Text(
                          'Nenhum mapa selecionado',
                          style: TextStyle(color: Colors.grey, fontWeight: FontWeight.w500),
                        ),
                        Text(
                          'Toque no botão para escolher da galeria',
                          style: TextStyle(fontSize: 12, color: Colors.grey),
                        ),
                      ],
                    ),
            ),
            const SizedBox(height: 12),

            // Botão da Galeria
            SizedBox(
              width: double.infinity,
              child: ElevatedButton.icon(
                style: ElevatedButton.styleFrom(
                  backgroundColor: const Color(0xFF1A365D),
                  padding: const EdgeInsets.symmetric(vertical: 12),
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                ),
                onPressed: _simularSelecaoGaleria,
                icon: Icon(_temMapaCarregado ? Icons.refresh : Icons.photo_library, color: Colors.white),
                label: Text(
                  _temMapaCarregado ? 'Trocar Mapa da Galeria' : 'Selecionar Mapa da Galeria',
                  style: const TextStyle(color: Colors.white, fontSize: 16),
                ),
              ),
            ),

            const SizedBox(height: 24),
            const Divider(),
            const SizedBox(height: 10),

            const Text(
              'Informações e Designações',
              style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: Color(0xFF1A365D)),
            ),
            const SizedBox(height: 10),
            const Text('• Status: Disponível\n• Última designação: Nenhuma\n• Anotações: Nenhuma'),
            
            const SizedBox(height: 20),
            ElevatedButton.icon(
              style: ElevatedButton.styleFrom(backgroundColor: Colors.green[700]),
              onPressed: () {
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(content: Text('Função de designar território em breve!')),
                );
              },
              icon: const Icon(Icons.person_add, color: Colors.white),
              label: const Text('Designar Território', style: TextStyle(color: Colors.white)),
            ),
          ],
        ),
      ),
    );
  }
}

